        "source": "../img/lesson-047-02-text.jpg",
        "items": [
          {
            "word": "like",
            "ipa": "/laɪk/",
            "pos": "v.",
            "meaning": "喜欢，想要"
          },
          {
            "word": "want",
            "ipa": "/wɒnt/",
            "pos": "v.",

  "sections": {
    "lesson": [
      {
        "id": "lesson-intro",
        "type": "text",
        "text": "Listen then answer this question. Why can’t Pamela type the letter?",
        "translation": "听录音，然后回答问题。帕梅拉为什么无法打信？",
        "source": "../img/lesson-045-01-text.jpg"
      },
      {
        "id": "lesson-scene-01",
        "type": "dialogue",
        "image": "scene-01",
        "source": "../img/lesson-045-01-text.jpg",
        "lines": [
          {
            "number": "01",
            "speaker": "The boss",
            "text": "Can you come here a minute please, Bob?",
            "translation": "请你来一下好吗，鲍勃？"
          },
          {
            "number": "02",
            "speaker": "Bob",
            "text": "Yes, sir?",
            "translation": "什么事，先生？"
          }
        ]
      },
      {
        "id": "lesson-scene-02",
        "type": "dialogue",
        "image": "scene-02",
        "source": "../img/lesson-045-01-text.jpg",
        "lines": [
          {
            "number": "03",
            "speaker": "The boss",
            "text": "Where’s Pamela?",
            "translation": "帕梅拉在哪儿？"
          },
          {
            "number": "04",
            "speaker": "Bob",
            "text": "She’s next door. She’s in her office, sir.",
            "translation": "她在隔壁，在她的办公室里，先生。"
          }
        ]
      },
      {
        "id": "lesson-scene-03",
        "type": "dialogue",
        "image": "scene-03",
        "source": "../img/lesson-045-01-text.jpg",
        "lines": [
          {
            "number": "05",
            "speaker": "The boss",
            "text": "Can she type this letter for me? Ask her please.",
            "translation": "她能为我打一下这封信吗？请问问她。"
          },
          {
            "number": "06",
            "speaker": "Bob",
            "text": "Yes, sir.",
            "translation": "好的，先生。"
          }
        ]
      },
      {
        "id": "lesson-scene-04",
        "type": "dialogue",
        "image": "scene-04",
        "source": "../img/lesson-045-01-text.jpg",
        "lines": [
          {
            "number": "07",
            "speaker": "Bob",
            "text": "Can you type this letter for the boss please, Pamela?",
            "translation": "请你把这封信给老板打一下可以吗，帕梅拉？"
          },
          {
            "number": "08",
            "speaker": "Pamela",
            "text": "Yes, of course I can.",
            "translation": "可以，当然可以。"
          }
        ]
      },
      {
        "id": "lesson-scene-05",
        "type": "dialogue",
        "image": "scene-05",
        "source": "../img/lesson-045-01-text.jpg",
        "lines": [
          {
            "number": "09",
            "speaker": "Bob",
            "text": "Here you are.",
            "translation": "给你。"
          },
          {
            "number": "10",
            "speaker": "Pamela",
            "text": "Thank you, Bob.",
            "translation": "谢谢你，鲍勃。"
          }
        ]
      },
      {
        "id": "lesson-scene-06",
        "type": "dialogue",
        "image": "scene-06",
        "source": "../img/lesson-045-01-text.jpg",
        "lines": [
          {
            "number": "11",
            "speaker": "Pamela",
            "text": "Bob!",
            "translation": "鲍勃！"
          },
          {
            "number": "12",
            "speaker": "Bob",
            "text": "Yes? What’s the matter?",
            "translation": "怎么了？怎么回事？"
          },
          {
            "number": "13",
            "speaker": "Pamela",
            "text": "I can’t type this letter.",
            "translation": "我打不了这封信。"
          }
        ]
      },
      {
        "id": "lesson-scene-07",
        "type": "dialogue",
        "image": "scene-07",
        "source": "../img/lesson-045-01-text.jpg",
        "lines": [
          {
            "number": "14",
            "speaker": "Pamela",
            "text": "I can’t read it! The boss’s handwriting is terrible!",
            "translation": "我看不懂这封信，老板的书写太糟糕了！"
          }
        ]
      },

        "lines": [
          {
            "number": "1",
            "speaker": "HANS",
            "text": "Where do you come from?",
            "translation": "你是哪国人？"
          },
          {
            "number": "2",
            "speaker": "DIMITRI",
            "text": "I come from Greece.",
            "translation": "我是希腊人。"
          },
          {
            "number": "3",
            "speaker": "HANS",
            "text": "What's the climate like in your country?",
            "translation": "你们国家的气候怎么样？"
          },
          {
            "number": "4",
            "speaker": "DIMITRI",
            "text": "It's very pleasant.",
            "translation": "气候非常宜人。"
          }
        ]
      },
      {
        "id": "lesson-scene-02",
        "type": "dialogue",
        "source": "../img/lesson-051-01-text.jpg",
        "image": "scene-02",
        "lines": [
          {
            "number": "5",
            "speaker": "HANS",
            "text": "What's the weather like in spring?",
            "translation": "春季的天气怎么样？"
          },
          {
            "number": "6",
            "speaker": "DIMITRI",
            "text": "It's often windy in March.",
            "translation": "3月里常常刮风。"
          },
          {
            "number": "7",
            "speaker": "DIMITRI",
            "text": "It's always warm in April and May,",
            "translation": "4月和5月的天气总是暖洋洋的，"
          },
          {
            "number": "8",
            "speaker": "DIMITRI",
            "text": "but it rains sometimes.",
            "translation": "但有时下雨。"
          }
        ]
      },
      {
        "id": "lesson-scene-03",
        "type": "dialogue",
        "source": "../img/lesson-051-01-text.jpg",
        "image": "scene-03",
        "lines": [
          {
            "number": "9",
            "speaker": "HANS",
            "text": "What's it like in summer?",
            "translation": "夏季的天气如何呢？"
          },
          {
            "number": "10",
            "speaker": "DIMITRI",
            "text": "It's always hot in June, July and August.",
            "translation": "6月、7月和8月的天气总是炎热的，"
          },
          {
            "number": "11",
            "speaker": "DIMITRI",
            "text": "The sun shines every day.",
            "translation": "每天都出太阳。"
